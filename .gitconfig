[push]
	default = simple
[user]
	name = Chaim Halbert
	email = chaim.leib.halbert@gmail.com
[color]
	ui = auto
[rerere]
	enabled = true
[pull]
	ff = only
[init]
	defaultBranch = master
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
	helper = libsecret
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
	helper = libsecret
[merge]
	tool = nvimdiff
